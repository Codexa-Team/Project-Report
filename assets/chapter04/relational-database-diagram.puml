@startuml
skinparam linetype ortho
skinparam roundcorner 5
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

hide circle

skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #1E293B
    BorderThickness 1.5
    ArrowColor #2563EB
    ArrowThickness 1.3
    HeaderBackgroundColor #1E3A8A
    HeaderFontColor #FFFFFF
    HeaderFontStyle bold
    HeaderFontSize 13
}

entity "users" as users {
  * id : BIGINT <<PK, auto_increment>>
  --
  * username : VARCHAR(50) <<UK>>
  * email : VARCHAR(100) <<UK>>
  * password : VARCHAR(255)
  * full_name : VARCHAR(150)
  phone : VARCHAR(25)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "roles" as roles {
  * id : BIGINT <<PK, auto_increment>>
  --
  * name : VARCHAR(30) <<UK>>
}

entity "user_roles" as user_roles {
  * user_id : BIGINT <<PK, FK>>
  * role_id : BIGINT <<PK, FK>>
}

entity "vehicles" as vehicles {
  * id : BIGINT <<PK, auto_increment>>
  --
  * owner_id : BIGINT <<FK>>
  * brand : VARCHAR(80)
  * model : VARCHAR(80)
  * year : INT
  * daily_price : DECIMAL(10,2)
  * status : VARCHAR(25)
  image_url : VARCHAR(500)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "bookings" as bookings {
  * id : BIGINT <<PK, auto_increment>>
  --
  * vehicle_id : BIGINT <<FK>>
  * renter_id : BIGINT <<FK>>
  * owner_id : BIGINT <<FK>>
  * start_date : DATE
  * end_date : DATE
  * total_price : DECIMAL(10,2)
  * status : VARCHAR(25)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "telemetry" as telemetry {
  * id : BIGINT <<PK, auto_increment>>
  --
  * vehicle_id : BIGINT <<FK>>
  * latitude : DOUBLE
  * longitude : DOUBLE
  * speed : DOUBLE
  * fuel_level : DOUBLE
  * odometer : DOUBLE
  * recorded_at : TIMESTAMP
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "reviews" as reviews {
  * id : BIGINT <<PK, auto_increment>>
  --
  * vehicle_id : BIGINT <<FK>>
  * renter_id : BIGINT <<FK>>
  * rating : INT
  comment : VARCHAR(500)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

' Relaciones IAM
users ||--|{ user_roles
roles ||--|{ user_roles

' Relaciones Listings
users ||--o{ vehicles : "owner_id"

' Relaciones Bookings
users ||--o{ bookings : "renter_id"
users ||--o{ bookings : "owner_id"
vehicles ||--o{ bookings : "vehicle_id"

' Relaciones IoT
vehicles ||--o{ telemetry : "vehicle_id"

' Relaciones Reviews
vehicles ||--o{ reviews : "vehicle_id"
users ||--o{ reviews : "renter_id"
@enduml
